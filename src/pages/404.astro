---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" lang="en">
  <div class="py-20 text-center space-y-5">
    <div class="text-5xl font-bold font-mono text-blue-600 dark:text-blue-400">404</div>
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">
      Page not found / Pagina non trovata
    </h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">
      The page you are looking for might have been moved during the website modernization.
    </p>
    <div class="flex items-center justify-center gap-3 pt-2">
      <a
        href="/"
        class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 transition"
      >
        Go to Home (EN)
      </a>
      <a
        href="/it"
        class="px-4 py-2 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-blue-500 transition"
      >
        Vai alla Home (IT)
      </a>
    </div>
  </div>
</BaseLayout>
