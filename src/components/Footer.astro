---
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const user = profile[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 mt-20 py-10 bg-slate-50/50 dark:bg-slate-900/30">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
    <div class="flex flex-col sm:flex-row items-center gap-2 text-center sm:text-left">
      <span>© 2024–{year} <strong class="text-slate-700 dark:text-slate-200">{user.name}</strong>.</span>
      <span>
        {t('footer.rights')}{' '}
        <a
          href={`https://creativecommons.org/licenses/by-sa/4.0/deed.${lang}`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-blue-600 dark:hover:text-blue-400"
        >
          CC BY-SA 4.0
        </a>.
      </span>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={user.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-900 dark:hover:text-white transition font-medium"
      >
        GitHub
      </a>
      <a
        href={user.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-900 dark:hover:text-white transition font-medium"
      >
        LinkedIn
      </a>
      <button
        type="button"
        data-email-user={user.emailUser}
        data-email-domain={user.emailDomain}
        class="email-trigger hover:text-slate-900 dark:hover:text-white transition font-medium cursor-pointer"
      >
        Email
      </button>
    </div>
  </div>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 mt-3 text-center sm:text-left text-[11px] text-slate-400 dark:text-slate-500">
    {t('footer.securityNote')}
  </div>
</footer>

<script is:inline>
  (() => {
    document.querySelectorAll('.email-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const u = btn.getAttribute('data-email-user');
        const d = btn.getAttribute('data-email-domain');
        if (u && d) {
          window.location.href = 'mailto:' + u + '@' + d;
        }
      });
    });
  })();
</script>
