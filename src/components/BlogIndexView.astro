---
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog', (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
const allYears = Array.from(
  new Set(posts.map((p) => p.data.date.getFullYear().toString()))
).sort((a, b) => Number(b) - Number(a));

function formatDate(d: Date, locale: Lang) {
  return d.toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('blog.title')}
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {t('blog.subtitle')}
      </p>
    </div>
    <a
      href={getLocalizedPath('/archive', lang)}
      class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0"
    >
      {t('home.viewArchive')}
    </a>
  </div>

  <!-- Filter Bar (Tags & Years) -->
  <div class="space-y-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/50">
    <!-- Tag Pills -->
    <div class="flex flex-wrap items-center gap-1.5">
      <button
        type="button"
        data-tag="all"
        class="blog-tag-btn px-3 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white transition cursor-pointer"
      >
        {t('blog.filterAllTags')}
      </button>
      {allTags.map((tag) => (
        <button
          type="button"
          data-tag={tag}
          class="blog-tag-btn px-3 py-1 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer"
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- Year Pills -->
    <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-slate-200/70 dark:border-slate-800/70">
      <button
        type="button"
        data-year="all"
        class="blog-year-btn px-2.5 py-0.5 rounded-md text-xs font-mono font-semibold bg-slate-800 text-white dark:bg-slate-200 dark:text-slate-900 transition cursor-pointer"
      >
        {t('blog.filterAllYears')}
      </button>
      {allYears.map((yr) => (
        <button
          type="button"
          data-year={yr}
          class="blog-year-btn px-2.5 py-0.5 rounded-md text-xs font-mono border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer"
        >
          {yr}
        </button>
      ))}
    </div>
  </div>

  <!-- Posts List -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="blog-posts-grid">
    {posts.map((post) => (
      <article
        data-post-tags={post.data.tags.join('|')}
        data-post-year={post.data.date.getFullYear().toString()}
        class="blog-card group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden flex flex-col justify-between hover:border-blue-500/60 transition shadow-2xs"
      >
        <div>
          <a href={getLocalizedPath(`/blog/${post.data.slugId}`, lang)} class="block overflow-hidden aspect-16/9 bg-slate-100 dark:bg-slate-800">
            <img
              src={post.data.image}
              alt={post.data.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          </a>

          <div class="p-5 space-y-2.5">
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300">
                {post.data.category}
              </span>
              <span class="font-mono text-slate-400">
                {formatDate(post.data.date, lang)} · {post.data.readingTime} {t('blog.minRead')}
              </span>
            </div>

            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
              <a href={getLocalizedPath(`/blog/${post.data.slugId}`, lang)}>
                {post.data.title}
              </a>
            </h2>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
              {post.data.description}
            </p>
          </div>
        </div>

        <div class="px-5 pb-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
              #{tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</div>

<script is:inline>
  (() => {
    let activeTag = 'all';
    let activeYear = 'all';

    const tagBtns = document.querySelectorAll('.blog-tag-btn');
    const yearBtns = document.querySelectorAll('.blog-year-btn');
    const cards = document.querySelectorAll('.blog-card');

    function applyFilter() {
      cards.forEach((card) => {
        const tags = (card.getAttribute('data-post-tags') || '').split('|');
        const year = card.getAttribute('data-post-year');
        const matchTag = activeTag === 'all' || tags.includes(activeTag);
        const matchYear = activeYear === 'all' || year === activeYear;
        if (matchTag && matchYear) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.getAttribute('data-tag') || 'all';
        tagBtns.forEach((b) => {
          b.className =
            'blog-tag-btn px-3 py-1 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer';
        });
        btn.className =
          'blog-tag-btn px-3 py-1 rounded-lg text-xs font-semibold bg-blue-600 text-white transition cursor-pointer';
        applyFilter();
      });
    });

    yearBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeYear = btn.getAttribute('data-year') || 'all';
        yearBtns.forEach((b) => {
          b.className =
            'blog-year-btn px-2.5 py-0.5 rounded-md text-xs font-mono border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer';
        });
        btn.className =
          'blog-year-btn px-2.5 py-0.5 rounded-md text-xs font-mono font-semibold bg-slate-800 text-white dark:bg-slate-200 dark:text-slate-900 transition cursor-pointer';
        applyFilter();
      });
    });
  })();
</script>
