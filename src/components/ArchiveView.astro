---
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('blog', (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const groupedByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(groupedByYear).sort((a, b) => Number(b) - Number(a));

function formatMonthDay(d: Date, locale: Lang) {
  return d.toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-US', {
    month: 'short',
    day: '2-digit',
  });
}
---

<div class="space-y-10">
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      {t('archive.title')}
    </h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      {t('archive.subtitle')}
    </p>
  </div>

  <div class="space-y-8">
    {years.map((year) => (
      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <h2 class="text-xl font-bold font-mono text-blue-600 dark:text-blue-400">
            {year}
          </h2>
          <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500">
            {groupedByYear[year].length}
          </span>
        </div>

        <div class="divide-y divide-slate-200/70 dark:divide-slate-800/70 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden">
          {groupedByYear[year].map((post) => (
            <a
              href={getLocalizedPath(`/blog/${post.data.slugId}`, lang)}
              class="group flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-5 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition"
            >
              <div class="flex items-center gap-3">
                <span class="text-xs font-mono text-slate-400 w-14 shrink-0">
                  {formatMonthDay(post.data.date, lang)}
                </span>
                <span class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                  {post.data.title}
                </span>
              </div>
              <div class="flex items-center gap-2 self-end sm:self-auto">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {post.data.category}
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>
