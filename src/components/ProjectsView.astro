---
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => p.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = ['Data Visualization', 'Data Science', 'Machine Learning'];

function formatDate(d: Date, locale: Lang) {
  return d.toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<div class="space-y-8">
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      {t('projects.title')}
    </h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      {t('projects.subtitle')}
    </p>
  </div>

  <!-- Category Filter Pills -->
  <div class="flex flex-wrap gap-2" id="project-filters">
    <button
      type="button"
      data-category="all"
      class="proj-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 text-white transition cursor-pointer"
    >
      {t('projects.filterAll')}
    </button>
    {categories.map((cat) => (
      <button
        type="button"
        data-category={cat}
        class="proj-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer"
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
    {projects.map((project) => (
      <article
        data-project-category={project.data.category}
        class="project-card group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden flex flex-col justify-between hover:border-blue-500/60 transition shadow-2xs"
      >
        <div>
          <a href={getLocalizedPath(`/projects/${project.data.slugId}`, lang)} class="block overflow-hidden aspect-16/10 bg-slate-100 dark:bg-slate-800">
            <img
              src={project.data.image}
              alt={project.data.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          </a>

          <div class="p-5 space-y-3">
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300">
                {project.data.category}
              </span>
              <span class="font-mono text-slate-400">
                {formatDate(project.data.date, lang)}
              </span>
            </div>

            <h2 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
              <a href={getLocalizedPath(`/projects/${project.data.slugId}`, lang)}>
                {project.data.title}
              </a>
            </h2>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {project.data.description}
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-3 border-t border-slate-100 dark:border-slate-800/80 space-y-3">
          <div class="flex flex-wrap gap-1.5">
            {project.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                #{tag}
              </span>
            ))}
          </div>

          <div class="flex items-center justify-between pt-1">
            <a
              href={getLocalizedPath(`/projects/${project.data.slugId}`, lang)}
              class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline"
            >
              {t('projects.readMore')}
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('.proj-filter-btn');
    const cards = document.querySelectorAll('.project-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-category');
        buttons.forEach((b) => {
          b.className =
            'proj-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-blue-500 transition cursor-pointer';
        });
        btn.className =
          'proj-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 text-white transition cursor-pointer';

        cards.forEach((card) => {
          const cat = card.getAttribute('data-project-category');
          if (selected === 'all' || cat === selected) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
