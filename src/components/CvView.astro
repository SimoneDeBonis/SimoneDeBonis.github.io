---
import { useTranslations, type Lang } from '../i18n/ui';
import { cvData } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = cvData[lang];
---

<div class="space-y-12">
  <!-- Header & PDF Download -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="space-y-1">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('cv.title')}
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {t('cv.subtitle')}
      </p>
    </div>

    <a
      href={cv.pdfPath}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition shrink-0 self-start sm:self-auto"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 12-4-4m4 4 4-4M4 20h16"></path>
      </svg>
      {t('cv.downloadPdf')}
    </a>
  </div>

  <!-- Quick-Jump Anchor Bar -->
  <div class="flex flex-wrap gap-2">
    <a
      href="#experience"
      class="px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition"
    >
      {t('cv.experience')}
    </a>
    <a
      href="#education"
      class="px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition"
    >
      {t('cv.education')}
    </a>
    <a
      href="#courses"
      class="px-3.5 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition"
    >
      {t('cv.courses')}
    </a>
  </div>

  <!-- 1. Experience Timeline -->
  <section id="experience" class="space-y-6 scroll-mt-24">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('cv.experience')}
      </h2>
    </div>

    <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-3 pl-6 space-y-6">
      {cv.experience.map((item, idx) => (
        <div class="relative p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-2">
          <span
            class:list={[
              'absolute -left-[31px] top-6 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-slate-950',
              idx === 0 ? 'bg-blue-600 ring-4 ring-blue-500/20' : 'bg-slate-400 dark:bg-slate-600',
            ]}
          ></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              {item.title} · <span class="text-blue-600 dark:text-blue-400">{item.organization}</span>
            </h3>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
              {item.period} · {item.location}
            </span>
          </div>
          {item.description && (
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.description}
            </p>
          )}
          {item.skills && item.skills.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-2">
              {item.skills.map((skill) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- 2. Education Timeline -->
  <section id="education" class="space-y-6 scroll-mt-24">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('cv.education')}
      </h2>
    </div>

    <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-3 pl-6 space-y-6">
      {cv.education.map((item) => (
        <div class="relative p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 space-y-2">
          <span class="absolute -left-[31px] top-6 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-slate-950 bg-indigo-600"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              {item.title}
            </h3>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
              {item.period} · {item.location}
            </span>
          </div>
          <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">
            {item.organization}
          </div>
          {item.description && (
            <p class="text-sm text-slate-600 dark:text-slate-300">
              {item.description}
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Courses & OpenBadges -->
  <section id="courses" class="space-y-6 scroll-mt-24">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('cv.courses')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {cv.courses.map((course) => (
        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 flex flex-col justify-between space-y-4">
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400">
              <span>{course.organization}</span>
              <span>{course.location}</span>
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">
              {course.title}
            </h3>
          </div>
          {course.badgeUrl && (
            <a
              href={course.badgeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline pt-2 border-t border-slate-100 dark:border-slate-800"
            >
              {t('cv.verifyBadge')}
            </a>
          )}
        </div>
      ))}
    </div>
  </section>
</div>
