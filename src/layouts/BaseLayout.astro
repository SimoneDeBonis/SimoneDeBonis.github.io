---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { getLocalizedPath, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'en',
  ogImage = '/assets/img/posts/profile.jpg',
} = Astro.props;

const user = profile[lang];
const metaDescription = description || user.tagline;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site || 'https://simonedebonis.github.io').toString();
const enAlternate = new URL(getLocalizedPath(currentPath, 'en'), Astro.site || 'https://simonedebonis.github.io').toString();
const itAlternate = new URL(getLocalizedPath(currentPath, 'it'), Astro.site || 'https://simonedebonis.github.io').toString();
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {user.name}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={user.name} />
    <meta name="robots" content="index, follow" />

    <!-- Hardened Content Security Policy (zero external scripts/CDNs) -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Canonical & i18n hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="it" href={itAlternate} />
    <link rel="alternate" hreflang="x-default" href={enAlternate} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png" />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${user.name}`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://simonedebonis.github.io').toString()} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Prevent Flash of Unstyled Theme (FOUC) -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-blue-600 selection:text-white">
    <Header lang={lang} currentPath={currentPath} />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchModal lang={lang} />
  </body>
</html>
